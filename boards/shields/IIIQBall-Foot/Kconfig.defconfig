config ZMK_KEYBOARD_NAME
    default "IIIQBall-Foot"

# 分離型機能をすべてのパーツで有効化
config ZMK_SPLIT
    default y

# --- ドングル(FOOT_F)専用の設定 ---
# Fをセントラル（親機）として設定します
if SHIELD_IIIQBALL-FOOT_F
    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    # 左右2つ(LとR)の子機をドングルに繋ぐ設定
    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    # 接続枠の拡張: 子機(2) + PC用プロファイル(5) = 7
    config BT_MAX_CONN
        default 7
    config BT_MAX_PAIRED
        default 7
endif

# --- 右手(FOOT_R: トラックボール側)専用の設定 ---
if SHIELD_IIIQBALL-FOOT_R
    # マウス操作（トラックボール）機能を有効化
    config ZMK_POINTING
        default y
endif