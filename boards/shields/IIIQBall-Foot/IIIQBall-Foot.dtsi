#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/input/input-event-codes.h>
#include <physical_layouts.dtsi>

&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                    w   h    x    y      rot     rx     ry
            
            = <&key_physical_attrs 100 100  400    0       0      0      0>

            , <&key_physical_attrs 100 100  525    0       0      0      0>
            , <&key_physical_attrs 100 100  625    0       0      0      0>
            , <&key_physical_attrs 100 100  725    0       0      0      0>
            , <&key_physical_attrs 100 100  825    0       0      0      0>
            , <&key_physical_attrs 100 100  925    0       0      0      0>
            , <&key_physical_attrs 100 100 1025    0       0      0      0>
            , <&key_physical_attrs 100 100 1125    0       0      0      0>

            , <&key_physical_attrs 100 100 1325    0       0      0      0>
            , <&key_physical_attrs 100 100 1425    0       0      0      0>
            , <&key_physical_attrs 100 100 1525    0       0      0      0>
            , <&key_physical_attrs 100 100 1625    0       0      0      0>
            , <&key_physical_attrs 100 100 1725    0       0      0      0>
            , <&key_physical_attrs 100 100 1825    0       0      0      0>
            , <&key_physical_attrs 100 100 1925    0       0      0      0>
            , <&key_physical_attrs 100 100 2025    0       0      0      0>

            , <&key_physical_attrs 100 100 2150    0       0      0      0>


        // Row 1
            , <&key_physical_attrs 100 100  400  125       0      0      0>

            , <&key_physical_attrs 100 100  525  125       0      0      0>
            , <&key_physical_attrs 100 100  625  125       0      0      0>
            , <&key_physical_attrs 100 100  725  125       0      0      0>
            , <&key_physical_attrs 100 100  825  125       0      0      0>
            , <&key_physical_attrs 100 100  925  125       0      0      0>
            , <&key_physical_attrs 100 100 1025  125       0      0      0>
            , <&key_physical_attrs 100 100 1125  125       0      0      0>

            , <&key_physical_attrs 100 100 1325  125       0      0      0>
            , <&key_physical_attrs 100 100 1425  125       0      0      0>
            , <&key_physical_attrs 100 100 1525  125       0      0      0>
            , <&key_physical_attrs 100 100 1625  125       0      0      0>
            , <&key_physical_attrs 100 100 1725  125       0      0      0>
            , <&key_physical_attrs 100 100 1825  125       0      0      0>
            , <&key_physical_attrs 200 100 1925  125       0      0      0>

            , <&key_physical_attrs 100 100 2150  125       0      0      0>


        // Row 2
            , <&key_physical_attrs 100 100  400  225       0      0      0>

            , <&key_physical_attrs 150 100  525  225       0      0      0>
            , <&key_physical_attrs 100 100  675  225       0      0      0>
            , <&key_physical_attrs 100 100  775  225       0      0      0>
            , <&key_physical_attrs 100 100  875  225       0      0      0>
            , <&key_physical_attrs 100 100  975  225       0      0      0>
            , <&key_physical_attrs 100 100 1075  225       0      0      0>

            , <&key_physical_attrs 100 100 1275  225       0      0      0>
            , <&key_physical_attrs 100 100 1375  225       0      0      0>
            , <&key_physical_attrs 100 100 1475  225       0      0      0>
            , <&key_physical_attrs 100 100 1575  225       0      0      0>
            , <&key_physical_attrs 100 100 1675  225       0      0      0>
            , <&key_physical_attrs 100 100 1775  225       0      0      0>
            , <&key_physical_attrs 100 100 1875  225       0      0      0>
            , <&key_physical_attrs 150 100 1975  225       0      0      0>

            , <&key_physical_attrs 100 100 2150  225       0      0      0>


        // Row 3
            , <&key_physical_attrs 100 100  400  325       0      0      0>

            , <&key_physical_attrs 175 100  525  325       0      0      0>
            , <&key_physical_attrs 100 100  700  325       0      0      0>
            , <&key_physical_attrs 100 100  800  325       0      0      0>
            , <&key_physical_attrs 100 100  900  325       0      0      0>
            , <&key_physical_attrs 100 100 1000  325       0      0      0>
            , <&key_physical_attrs 100 100 1100  325       0      0      0>

            , <&key_physical_attrs 100 100 1300  325       0      0      0>
            , <&key_physical_attrs 100 100 1400  325       0      0      0>
            , <&key_physical_attrs 100 100 1500  325       0      0      0>
            , <&key_physical_attrs 100 100 1600  325       0      0      0>
            , <&key_physical_attrs 100 100 1700  325       0      0      0>
            , <&key_physical_attrs 100 100 1800  325       0      0      0>
            , <&key_physical_attrs 225 100 1900  325       0      0      0>

            , <&key_physical_attrs 100 100 2150  325       0      0      0>


        // Row 4
            , <&key_physical_attrs 100 100  400  425       0      0      0>

            , <&key_physical_attrs 225 100  525  425       0      0      0>
            , <&key_physical_attrs 100 100  750  425       0      0      0>
            , <&key_physical_attrs 100 100  850  425       0      0      0>
            , <&key_physical_attrs 100 100  950  425       0      0      0>
            , <&key_physical_attrs 100 100 1050  425       0      0      0>
            , <&key_physical_attrs 100 100 1150  425       0      0      0>

            , <&key_physical_attrs 100 100 1350  425       0      0      0>
            , <&key_physical_attrs 100 100 1450  425       0      0      0>
            , <&key_physical_attrs 100 100 1550  425       0      0      0>
            , <&key_physical_attrs 100 100 1650  425       0      0      0>
            , <&key_physical_attrs 100 100 1750  425       0      0      0>
            , <&key_physical_attrs 175 100 1850  425       0      0      0>

            , <&key_physical_attrs 100 100 2050  425       0      0      0>


        // Row 5
            , <&key_physical_attrs 100 100  0    525       0      0      0>
            , <&key_physical_attrs 100 100  100  525       0      0      0>
            , <&key_physical_attrs 100 100  200  525       0      0      0>


            , <&key_physical_attrs 100 100  400  525       0      0      0>

            , <&key_physical_attrs 125 100  525  525       0      0      0>
            , <&key_physical_attrs 125 100  650  525       0      0      0>
            , <&key_physical_attrs 125 100  775  525       0      0      0>
            , <&key_physical_attrs 125 100  900  525       0      0      0>
            , <&key_physical_attrs 100 100 1025  525       0      0      0>
            , <&key_physical_attrs 100 100 1125  525       0      0      0>

            , <&key_physical_attrs 100 100 1325  525       0      0      0>
            , <&key_physical_attrs 125 100 1425  525       0      0      0>

            , <&key_physical_attrs 100 100 1950  525       0      0      0>
            , <&key_physical_attrs 100 100 2050  525       0      0      0>
            , <&key_physical_attrs 100 100 2150  525       0      0      0>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <19>;
        map = <
                                RC(3,1) RC(4,0) RC(5,0) RC(6,0) RC(7,0) RC(8,0) RC(9,0) RC(10,0)     RC(11,1) RC(12,0) RC(13,0) RC(14,0) RC(15,0) RC(16,0) RC(17,0) RC(18,0) RC(18,1)
                                RC(3,2) RC(4,2) RC(5,1) RC(6,1) RC(7,1) RC(8,1) RC(9,1) RC(10,1)     RC(11,2) RC(12,2) RC(13,1) RC(14,1) RC(15,1) RC(16,1) RC(17,1)          RC(18,3)
                                RC(3,3) RC(4,3)         RC(6,2) RC(7,2) RC(8,2) RC(9,2) RC(10,2)     RC(11,3) RC(12,3) RC(13,3) RC(14,2) RC(15,2) RC(16,2) RC(17,2) RC(18,2) RC(18,4)
                                RC(3,4) RC(4,4)         RC(6,4) RC(7,3) RC(8,3) RC(9,3) RC(10,3)     RC(11,4) RC(12,4) RC(13,4) RC(14,4) RC(15,3) RC(16,3) RC(17,3)          RC(18,5)
                                RC(3,5) RC(4,5)         RC(6,5) RC(7,5) RC(8,4) RC(9,4) RC(10,4)     RC(11,5) RC(12,5) RC(13,5) RC(14,5) RC(15,5) RC(16,4)           RC(17,4)
    RC(1,0) RC(2,6) RC(3,0)     RC(3,6) RC(4,6) RC(5,6) RC(6,6) RC(7,6)         RC(8,6) RC(9,5)      RC(11,6) RC(12,6)                                     RC(13,6) RC(14,6) RC(15,6)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;
    };


    left1_encoder: encoder_left1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };
    left2_encoder: encoder_left2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    right1_encoder: encoder_right1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };
    right2_encoder: encoder_right2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left1_encoder &left2_encoder &right1_encoder &right2_encoder>;
        triggers-per-rotation = <20>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "disabled";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "disabled";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        /* motion-gpios を削除しました */
        res-cpi = <600>;
        zephyr,axis-x = <INPUT_REL_Y>;
        zephyr,axis-y = <INPUT_REL_X>;
        invert-y;
        force-awake;
    };
};

/ {
  trackball_listener: trackball_listener {
    compatible = "zmk,input-listener";
    status = "disabled";
    device = <&trackball>;
  };
};